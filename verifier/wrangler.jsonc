{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinball-foundry-verifier",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CHAIN_ID": "11155111",
    "ALLOWED_ORIGIN": "https://game.invalid",
    "VERIFIER_ADDRESS": "0x0000000000000000000000000000000000000000",
    "LEADERBOARD_ADDRESS": "0x0000000000000000000000000000000000000000"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pinball-foundry-challenges",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
